#!/usr/bin/env python3
"""Оболочка для SSH-ключей хранителя (forced command в authorized_keys aleks).

  restrict,command="~/.local/bin/guardian-shell heal"     … poh-guardian-heal
  restrict,command="~/.local/bin/guardian-shell approved" … poh-guardian-approved

heal     — ключ ИИ-агента: диагностика + обратимые действия из белого списка.
approved — ключ, который workflow достаёт только после ✅ владельца в Telegram:
           произвольная команда под aleks (без sudo и секретов).
Команда приходит в $SSH_ORIGINAL_COMMAND. Python 3.10 (Ubuntu 22.04), только stdlib.
"""
import json
import os
import re
import shlex
import subprocess
import sys
import time

HOME = os.path.expanduser("~")
STATE = os.path.join(HOME, ".local/state/poh-guardian")
CHANGES = os.path.join(STATE, "changes.jsonl")
RESTARTS = os.path.join(STATE, "restarts.json")

# Юниты aleks, которые агент вправе перезапускать сам. Не входят:
# hermes-gateway (боты молчат ~4 мин и применяется всё накопленное в конфигах — только по ✅),
# repowise-mcp (рвёт сессии), всё системное (нужен sudo).
RESTARTABLE = {
    "matrix-synapse", "hermes-dashboard", "poh-harness", "pi-web", "pi-web-sessiond",
    "pi-totp-gate", "dsh-token-relay", "poh-feed", "news-start", "news-mtslink",
    "corp-link", "corp-link-bot", "corp-jira", "corp-mail", "corp-chrome-watchdog",
    "po-sprint-observe", "poh-sprint-agent", "poh-sprint-daily",
    "poh-widget-manager", "poh-widget-calendar", "poh-widget-inbox", "poh-widget-harness",
    "poh-widget-mtslink-room", "poh-widget-messenger-connector", "poh-widget-telegram-connector",
    "poh-widget-sprint-business", "poh-widget-news", "poh-hermes-bridge",
    "comunager-bridge", "comunager-groups", "mautrix-telegram", "obs-llm-exporter",
    "poh-guardian-canary",
}
MAX_RESTARTS_PER_HOUR = 3

# Процессы, которые можно снять: тестовые браузеры и прогоны (инцидент 2026-10-08 — забытый
# Chrome на Xvfb, дубль scroll-throttle, циклы watch-prod). Старше 10 минут, владелец aleks.
KILLABLE = [
    r"--user-data-dir=/tmp/", r"/tmp/pw-", r"playwright", r"prod-check\.mjs", r"/e2e/",
    r"\bXvfb :9\d\b", r"watch-prod\.sh", r"scroll-throttle",
]
NEVER_KILL = [r"hermes", r"synapse", r"sshd", r"systemd", r"nginx", r"gotosocial", r"python3 -m sprintagent"]

SECRET = re.compile(
    r"\.env\b|auth\.json|\.hermes/(config\.yaml|profiles/[^ ]*/config)|/\.ssh/|bot\.env|"
    r"credentials|exchange\.(env|pass)|hermes-key|agent-token|zai-keys|letsencrypt|chpasswd|"
    r"matrix-accounts|mts_vpn_env|\.vpn\b|SUDO_PASSWORD|/proc/[0-9]+/environ|\bprintenv\b|"
    r"\.google_authenticator|signing\.key|registration\.yaml|feed-token|secrets/|/etc/wireguard",
    re.I)
REDACT = [
    (re.compile(r"(?i)\bbearer\s+[A-Za-z0-9._~+/=-]+"), "Bearer ***"),
    (re.compile(r"(?i)\b(token|password|passwd|secret|api[_-]?key|authorization|cookie)(\"?\s*[:=]\s*\"?)(?!Bearer \*\*\*)[^\s\",]+"), r"\1\2***"),
    (re.compile(r"\b(syt_|ghp_|gho_|github_pat_|sk-|xox[bap]-)[A-Za-z0-9_-]{8,}"), "***"),
    (re.compile(r"[A-Za-z0-9+/_-]{48,}={0,2}"), "***"),
]
UNIT_RE = re.compile(r"^[A-Za-z0-9@._-]{1,80}$")
PATH_RE = re.compile(r"^/[A-Za-z0-9/._?=&%-]{0,200}$")

ENV = dict(os.environ, XDG_RUNTIME_DIR="/run/user/%d" % os.getuid(), LC_ALL="C.UTF-8",
           SYSTEMD_PAGER="", PAGER="cat")
ENV.setdefault("DBUS_SESSION_BUS_ADDRESS", "unix:path=/run/user/%d/bus" % os.getuid())


class Refused(Exception):
    pass


def redact(text):
    for rx, rep in REDACT:
        text = rx.sub(rep, text)
    return text


def guard_secret(cmd):
    if SECRET.search(cmd):
        raise Refused("команда касается секретов — хранителю нельзя (правило 2 CLAUDE.md)")
    if re.search(r"(^|[;&|\s])sudo\b|\bsu\s", cmd):
        raise Refused("sudo/su — шаг владельца с паролем; опиши команду в предложении")
    if re.search(r"\bpkill\s+-f\b", cmd):
        raise Refused("pkill -f запрещён (инцидент 2026-09-30) — только systemctl --user или kill <pid>")


def sh(cmd, timeout=20):
    try:
        p = subprocess.run(cmd, shell=isinstance(cmd, str), capture_output=True, text=True,
                           timeout=timeout, env=ENV)
        out = (p.stdout + p.stderr).strip()
        return out if p.returncode == 0 else "%s\n[код %s]" % (out, p.returncode)
    except subprocess.TimeoutExpired:
        return "[таймаут %s с]" % timeout


def log_change(**rec):
    os.makedirs(STATE, exist_ok=True)
    rec.setdefault("ts", time.strftime("%Y-%m-%dT%H:%M:%S%z"))
    with open(CHANGES, "a") as f:
        f.write(json.dumps(rec, ensure_ascii=False) + "\n")


def tail_changes(n=15):
    try:
        with open(CHANGES) as f:
            return "".join(f.readlines()[-n:]).strip() or "(пусто)"
    except OSError:
        return "(журнала изменений ещё нет)"


# ---------------- verbs: диагностика ----------------

def v_overview(_):
    parts = [
        ("uptime", "uptime"),
        ("память", "free -m; swapon --show"),
        ("давление (PSI)", "cat /proc/pressure/memory /proc/pressure/cpu"),
        ("диск", "df -h / /home 2>/dev/null"),
        ("упавшие юниты aleks", "systemctl --user --failed --no-legend --no-pager"),
        ("упавшие системные", "systemctl --failed --no-legend --no-pager"),
        ("ключевые юниты", "systemctl --user is-active matrix-synapse hermes-gateway hermes-dashboard "
                           "pi-totp-gate poh-widget-inbox corp-link comunager-bridge | paste -sd' '"),
        ("nginx", "systemctl is-active nginx"),
        ("VPN cscotun0", "ip -br a show cscotun0 2>&1"),
        ("топ памяти", "ps -eo pid,user,etime,rss,pcpu,comm --sort=-rss | head -12"),
        ("топ CPU", "ps -eo pid,user,etime,rss,pcpu,comm --sort=-pcpu | head -8"),
        ("docker", "sg docker -c 'docker ps --format \"{{.Names}} {{.Status}}\"'"),
        ("OOM за 6 ч", "journalctl -k --since -6h --no-pager | grep -iE 'oom|killed process' | tail -5"),
        ("перезагрузки", "last -x reboot | head -3"),
        ("изменения (poh-restart и хранитель)", "true"),
    ]
    out = []
    for title, cmd in parts:
        body = tail_changes(10) if title.startswith("изменения") else sh(cmd)
        out.append("## %s\n%s" % (title, body))
    return "\n\n".join(out)


def v_units(_):
    units = sorted(RESTARTABLE | {"hermes-gateway", "repowise-mcp"})
    return sh("for u in %s; do printf '%%-34s %%s\\n' $u $(systemctl --user is-active $u); done"
              % " ".join(units))


def _n(args, default, top):
    n = int(args[1]) if len(args) > 1 and args[1].isdigit() else default
    return min(n, top)


def v_logs(args):
    if not args or not UNIT_RE.match(args[0]):
        raise Refused("logs <юнит aleks> [строк≤300]")
    return sh(["journalctl", "--user", "-u", args[0], "-n", str(_n(args, 80, 300)), "--no-pager"])


def v_syslog(args):
    if not args or not UNIT_RE.match(args[0]):
        raise Refused("syslog <системный юнит> [строк≤300]")
    return sh(["journalctl", "-u", args[0], "-n", str(_n(args, 80, 300)), "--no-pager"])


def v_restarts(args):
    since = args[0] if args and re.match(r"^-?\d+[hm]$", args[0]) else "6h"
    since = since if since.startswith("-") else "-" + since
    # «Started/Stopped <описание>» и «<юнит>.service: Consumed … CPU time» (= остановка) — от менеджера aleks
    return sh("journalctl --user --since %s --no-pager -o short | grep -E "
              "'systemd\\[[0-9]+\\]: (Started |Stopped |Stopping |.*\\.service: (Main process exited|"
              "Failed with result|Scheduled restart|Consumed .* CPU time))' "
              "| grep -vE 'run-u[0-9]+|app-.*\\.scope|Chromium|node-v[0-9]' | tail -60" % shlex.quote(since))


def v_nginx_errors(args):
    return sh(["tail", "-n", str(_n(["x"] + args, 60, 300)), "/var/log/nginx/error.log"])


def v_nginx_5xx(args):
    # Сколько 5xx по минутам за последние N строк access.log.
    return sh("tail -n 20000 /var/log/nginx/access.log | awk '$9 ~ /^5/ {split($4,a,\":\"); "
              "print a[2]\":\"a[3], $9, $7}' | awk '{print $1, $2, $3}' | sed -E 's/\\?.*//' "
              "| sort | uniq -c | tail -40")


def v_http(args):
    if not args or not args[0].isdigit():
        raise Refused("http <порт на 127.0.0.1> [/путь]")
    path = args[1] if len(args) > 1 else "/"
    if not PATH_RE.match(path):
        raise Refused("недопустимый путь")
    host = "135.106.218.5" if args[0] == "3955" else "127.0.0.1"
    return sh(["curl", "-s", "-m", "10", "-o", "/dev/null", "-w", "%{http_code} %{time_total}s",
               "http://%s:%s%s" % (host, args[0], path)])


def v_ps(args):
    pat = args[0] if args else ""
    if pat and not re.match(r"^[A-Za-z0-9._-]{1,40}$", pat):
        raise Refused("ps [имя процесса]")
    cmd = "ps -eo pid,user,etime,rss,pcpu,args --sort=-rss | cut -c1-220"
    return sh(cmd + (" | grep -i -- %s | grep -v grep | head -30" % shlex.quote(pat) if pat else " | head -40"))


def v_changes(args):
    return tail_changes(_n(["x"] + args, 20, 200))


# ---------------- verbs: обратимые действия ----------------

def _restart_budget(unit, now):
    try:
        with open(RESTARTS) as f:
            data = json.load(f)
    except (OSError, ValueError):
        data = {}
    recent = [t for t in data.get(unit, []) if now - t < 3600]
    if len(recent) >= MAX_RESTARTS_PER_HOUR:
        raise Refused("%s уже перезапускали %d раза за час — дальше только по ✅ владельца"
                      % (unit, len(recent)))
    data[unit] = recent + [now]
    os.makedirs(STATE, exist_ok=True)
    with open(RESTARTS, "w") as f:
        json.dump(data, f)


def v_restart(args):
    if not args or args[0] not in RESTARTABLE:
        raise Refused("restart: только юниты из белого списка (см. `units`); остальное — предложением")
    unit = args[0]
    _restart_budget(unit, time.time())
    before = sh(["systemctl", "--user", "is-active", unit])
    out = sh(["systemctl", "--user", "restart", unit], timeout=120)
    time.sleep(5)
    after = sh(["systemctl", "--user", "is-active", unit])
    log_change(unit=unit, action="restart", by="guardian", before=before, after=after)
    return "restart %s: было %s → стало %s\n%s" % (unit, before, after, out)


def _proc(pid):
    base = "/proc/%d" % pid
    with open(base + "/cmdline", "rb") as f:
        cmdline = f.read().replace(b"\0", b" ").decode(errors="replace").strip()
    uid = os.stat(base).st_uid
    with open(base + "/stat") as f:
        start_ticks = int(f.read().rsplit(")", 1)[1].split()[19])
    with open("/proc/uptime") as f:
        uptime = float(f.read().split()[0])
    age = uptime - start_ticks / os.sysconf("SC_CLK_TCK")
    return cmdline, uid, age


def killable(cmdline, uid, age, my_uid):
    if uid != my_uid:
        return False, "процесс не aleks"
    if any(re.search(p, cmdline) for p in NEVER_KILL):
        return False, "процесс из списка «никогда»"
    if not any(re.search(p, cmdline) for p in KILLABLE):
        return False, "не похож на тестовый браузер/прогон — предложи владельцу"
    if age < 600:
        return False, "моложе 10 минут — возможно, кто-то им сейчас пользуется"
    return True, ""


def v_kill(args):
    if not args or not args[0].isdigit():
        raise Refused("kill <pid>")
    pid = int(args[0])
    try:
        cmdline, uid, age = _proc(pid)
    except OSError:
        raise Refused("процесса %d нет" % pid)
    ok, why = killable(cmdline, uid, age, os.getuid())
    if not ok:
        raise Refused("kill %d: %s" % (pid, why))
    os.kill(pid, 15)
    time.sleep(5)
    if os.path.exists("/proc/%d" % pid):
        os.kill(pid, 9)
    log_change(action="kill", pid=pid, cmd=cmdline[:160], by="guardian")
    return "снят %d (%s, %.0f мин)" % (pid, cmdline[:120], age / 60)


def v_chrome_restart(args):
    name = {"corp": "corp-chrome", "mtslink": "mtslink-chrome"}.get(args[0] if args else "")
    if not name:
        raise Refused("chrome-restart corp|mtslink")
    out = sh("sg docker -c 'docker exec %s pkill -TERM -x chrome'; sleep 10; "
             "sg docker -c 'docker exec %s pkill -KILL -x chrome'; sleep 8; "
             "curl -s -m 5 -o /dev/null -w 'CDP %%{http_code}' http://127.0.0.1:9222/json/version"
             % (name, name), timeout=60)
    log_change(action="chrome-restart", container=name, by="guardian")
    return out


HEAL_VERBS = {
    "overview": v_overview, "units": v_units, "logs": v_logs, "syslog": v_syslog,
    "restarts": v_restarts, "nginx-errors": v_nginx_errors, "nginx-5xx": v_nginx_5xx,
    "http": v_http, "ps": v_ps, "changes": v_changes,
    "restart": v_restart, "kill": v_kill, "chrome-restart": v_chrome_restart,
}


def help_text():
    return ("guardian-shell (heal): " + ", ".join(sorted(HEAL_VERBS)) +
            "\nДействия вне списка — предложением владельцу (кнопка ✅ в Telegram).")


def run(mode, command):
    command = (command or "").strip()
    if mode == "heal":
        if not command or command in ("help", "-h", "--help"):
            return help_text()
        args = shlex.split(command)
        verb = HEAL_VERBS.get(args[0])
        if verb is None:
            raise Refused("неизвестная команда %r. %s" % (args[0], help_text()))
        return verb(args[1:])
    if mode == "approved":
        if not command:
            raise Refused("approved: пустая команда")
        guard_secret(command)
        out = sh(["bash", "-lc", command], timeout=300)
        log_change(action="approved", cmd=command[:300], by="owner-approved")
        return out
    raise Refused("неизвестный режим ключа")


def main():
    mode = sys.argv[1] if len(sys.argv) > 1 else ""
    try:
        out = run(mode, os.environ.get("SSH_ORIGINAL_COMMAND", ""))
        print(redact(out))
        return 0
    except Refused as e:
        print("ОТКАЗ: %s" % e)
        return 2


if __name__ == "__main__":
    sys.exit(main())
